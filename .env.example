# SmartResume AI Environment Configuration

# Google Gemini API Key (Recommended for AI Resume Assistant)
GEMINI_API_KEY=
# Optional. Leave blank to let SmartResume AI choose an available Gemini Flash model.
GEMINI_MODEL=

# Optional: AWS Credentials (if using AWS Comprehend / Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Application Settings
APP_ENV=development
DB_PATH=data/smartresume.db
LOG_LEVEL=INFO
ENABLE_OCR=true
TESSERACT_CMD=tesseract

